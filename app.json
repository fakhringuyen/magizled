{
  "expo": {
    "name": "MagizLED",
    "slug": "mobile-app",
    "version": "4.4.2",
    "orientation": "default",
    "icon": "./assets/images/magiz-icon.png",
    "scheme": "magizled",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070C",
    "primaryColor": "#F048C0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fakhri626.magizled",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "MagizLED talks to your LED controller on the local Wi-Fi network."
      }
    },
    "android": {
      "package": "com.fakhri626.magizled",
      "versionCode": 11,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#07070C",
        "foregroundImage": "./assets/images/magiz-icon-foreground.png",
        "monochromeImage": "./assets/images/magiz-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-magiz.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070C",
          "image": "./assets/images/magiz-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-web-browser",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b84e743-d842-4ada-9461-d886be42dd36"
      }
    },
    "owner": "fakhringuyen",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2b84e743-d842-4ada-9461-d886be42dd36",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
